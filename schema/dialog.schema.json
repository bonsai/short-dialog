{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShortDialog",
  "type": "object",
  "required": ["duration", "messages"],
  "properties": {
    "duration": { "const": 80 },
    "title": { "type": "string" },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "speaker", "text"],
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "number", "minimum": 0, "maximum": 80 },
          "end": { "type": "number", "exclusiveMinimum": 0, "maximum": 80 },
          "speaker": { "enum": ["left", "right"] },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
